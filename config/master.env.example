# Master validator, mainnet subnet 31. See docs/MASTER.md.
# Incentive v3 (score version 11) is the only scoring path; there is no activation flag.
# Starting the service with this file signs and sets weights.
# ENVIRONMENT is a log label only, not a network or dry-run switch.
ENVIRONMENT=production
LOG_LEVEL=INFO
NETWORK=finney
NETUID=31

# Local wallet names. Never put a private key or recovery phrase here.
WALLET_NAME=validator
HOTKEY_NAME=default
WALLET_PATH=

BUNDLE_MODE=chain-v2
BUNDLE_ROLE=master
ALLOCATION_MODE=v2
ALLOCATION_EXPECTED_GENESIS_HASH=0x2f0555cc76fc2840a25a6ea3b9637146806f1f44b090c175ffde2a7e5ab36c03
# Mainnet master validator / subnet owner (uid 0), the weight-bundle signer. Public;
# pinned in environment.py (MAINNET_MASTER_HOTKEY_SS58).
# Your master signing hotkey must match this public identity.
MASTER_VALIDATOR_HOTKEY_SS58=5CDZ527X1CiStK1ViGkbC4EjVoouwiGW4ijRKRFfrLpQfftn
# Keep existing mainnet state on upgrade; never copy another deployment's state here.
BUNDLE_STATE_DIR=./bundle_state
# Recall Kubo publication API (publish, pin and fetch). Plain HTTP (bundle data is
# public): plaintext is allowed for this host only.
BUNDLE_IPFS_API_URL=http://ipfs.rec4ll.com:5001
BUNDLE_GATEWAY_URLS=
IPFS_READ_URL=
IPFS_ALLOW_PLAINTEXT=true

# Readiness share of each tier budget (the rest is service), 0..1. Default 0.40.
INCENTIVE_V3_READINESS_SPLIT=0.40
# Recall never burns: unearned units are paid to miners pro rata, and split equally across
# all miners when nobody earned.
# How each tier's readiness pool is paid: shares (default) pays every eligible miner by
# quality, at most one slot's worth each; slots pays only the four slot holders.
INCENTIVE_V3_READINESS_MODE=shares
INCENTIVE_V3_SLOT_WINDOW_HOURS=48
INCENTIVE_V3_ELIGIBILITY_SCOPE=

WEIGHT_LOOP_ENABLED=true
VALIDATOR_POLL_SECONDS=12
# Master-only API settings. Provision the key privately; never commit .env.
RECALL_API_URL=https://rec4ll.com/api
INTERNAL_API_KEY=
ALLOCATION_ALLOW_PLAINTEXT=false

# Optional, off by default. The default policy reuses the last verified vector with no age
# limit while it is usable. Setting a positive block count makes the weight loop stop
# re-setting a vector older than that, fall back to the owner/immune UID and alert, which
# changes payouts during publication outages. 4320 blocks is 12 tempos only at tempo 360.
# WEIGHT_MAX_STALE_BLOCKS=4320
